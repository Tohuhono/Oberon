{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "strict",
  "remoteCache": {
    "enabled": false
  },
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "AUTH_*",
    "BASE_URL",
    "BETTER_AUTH_URL",
    "PORT",
    "USE_DEVELOPMENT_*",
    "SQLITE_FILE",
    "DATABASE_URL",
    "TURSO_URL",
    "TURSO_TOKEN",
    "MASTER_EMAIL",
    "EMAIL_FROM",
    "RESEND_SECRET",
    "UPLOADTHING_SECRET",
    "VERCEL_URL",
    "VERCEL_BLOB_API_URL",
    "NEXT_PUBLIC_VERCEL_BLOB_API_URL"
  ],
  "globalDependencies": [".github/workflows/**"],
  "futureFlags": {
    "watchUsingTaskInputs": true,
    "errorsOnlyShowHash": false
  },
  "tasks": {
    "//#clean:db": {
      "cache": false
    },
    "prebuild": {
      "dependsOn": ["^build", "//#clean:db"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.oberon/**",
        "!.turbo/**",
        "!.next/**",
        "!.playwright/**"
      ],
      "outputs": [".oberon/**"]
    },
    "build": {
      "dependsOn": ["^build", "prebuild"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        ".oberon/**",
        "!.oberon/db/oberon.db*",
        "plugins/**",
        "!.turbo/**",
        "!.next/**",
        "!.playwright/**"
      ],
      "outputs": [".next/**", ".vercel/output/**", "dist/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["wait:clean", "^wait", "prebuild"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "check": {
      "dependsOn": ["lint", "tsc", "test:unit"]
    },
    "clean": {
      "cache": false
    },
    "generate:migrations": {
      "cache": false
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.oberon/**",
        "!.turbo/**",
        "!.next/**",
        "!.playwright/**"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.oberon/**",
        "!.turbo/**",
        "!.next/**",
        "!.playwright/**"
      ],
      "outputs": [".playwright/**"]
    },
    "test:e2e:ui": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:coa": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.oberon/**",
        "!.turbo/**",
        "!.next/**",
        "!.playwright/**"
      ],
      "outputs": [".playwright"]
    },
    "test:coa:nextjs": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.oberon/**",
        "!.turbo/**",
        "!.next/**",
        "!.playwright/**"
      ],
      "outputs": [".playwright"]
    },
    "test:coa:tanstack": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.oberon/**",
        "!.turbo/**",
        "!.next/**",
        "!.playwright/**"
      ],
      "outputs": [".playwright"]
    },
    "test:coa:ui": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:smoke": {
      "dependsOn": [],
      "outputs": [".playwright"],
      "env": ["PLAYWRIGHT_BASE_URL", "VERCEL_PROTECTION_BYPASS"]
    },
    "test:tdd": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.oberon/**",
        "!.turbo/**",
        "!.next/**",
        "!.playwright/**"
      ],
      "dependsOn": ["build"],
      "outputs": [".playwright"]
    },
    "test:tdd:ui": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "tsc": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.oberon/**",
        "!.turbo/**",
        "!.next/**",
        "!.playwright/**"
      ],
      "outputs": []
    },
    "wait": {
      "cache": false,
      "outputs": []
    },
    "wait:clean": {
      "cache": false,
      "outputs": []
    },
    "prepublishOnly": {
      "dependsOn": ["build"]
    },
    "validate": {
      "dependsOn": ["lint", "tsc", "test:unit", "test:e2e", "test:coa"]
    }
  }
}
