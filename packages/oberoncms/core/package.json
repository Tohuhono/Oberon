{
  "name": "@oberoncms/core",
  "version": "0.20.0",
  "description": "OberonCMS is a cloud deployable CMS written in typescript based on the Puck visual editor",
  "keywords": [
    "cms",
    "nextjs",
    "oberon",
    "oberoncms",
    "puck",
    "react"
  ],
  "license": "MIT",
  "author": "Tohuhono ltd",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tohuhono/Oberon",
    "directory": "packages/oberoncms/core"
  },
  "files": [
    "dist",
    "src",
    "tailwind.css",
    "CHANGELOG*",
    "README*",
    "LICENSE*"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./auth": "./dist/auth.js",
    "./auth/client": "./dist/auth/client.js",
    "./auth/server": "./dist/auth/server.js",
    "./adapter": "./dist/adapter.js",
    "./schemas": "./dist/lib/dtd.js",
    "./render": "./dist/render.js",
    "./editor": "./dist/editor.js",
    "./provider": "./dist/provider.js",
    "./provider/client": "./dist/provider.client.js",
    "./tailwind.css": "./tailwind.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "clean": "odt clean",
    "dev": "vite build --watch",
    "wait": "wait-on ./dist/version && echo done",
    "wait:clean": "rimraf ./dist/version",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc --pretty"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@puckeditor/core": "^0.23.0",
    "@tohuhono/ui": "workspace:*",
    "@tohuhono/utils": "workspace:*",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.6",
    "filesize": "^11.0.25",
    "react-hook-form": "^7.89.0",
    "swr": "^2.5.1",
    "use-debounce": "^10.1.1",
    "walkjs": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dev/oxlint": "workspace:*",
    "@dev/scripts": "workspace:*",
    "@dev/typescript": "workspace:*",
    "@dev/vite": "workspace:*",
    "@dev/vitest": "workspace:*",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
