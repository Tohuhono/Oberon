{
  "name": "@oberon/recipe-tanstack",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "clean": "odt clean",
    "dev": "vite dev --port 3000",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prebuild": "tsx ./oberon/prebuild.ts",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "start": "vite preview --strictPort",
    "tsc": "tsc --pretty"
  },
  "dependencies": {
    "@oberoncms/core": "workspace:*",
    "@oberoncms/plugin-development": "workspace:*",
    "@oberoncms/plugin-tanstack": "workspace:*",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-cli-only": "^0.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.3"
  },
  "pnpm": {
