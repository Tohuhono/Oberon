{
  "name": "@oberon/recipe-nextjs",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "odt clean",
    "dev": "next dev --turbo --port 3030",
    "format": "oxfmt \"**/*.{ts,tsx,js,jsx,css,md,mdx,json}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,css,md,mdx,json}\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prebuild": "tsx ./oberon/prebuild.ts",
    "start": "next start",
    "tsc": "tsc --pretty"
  },
  "dependencies": {
    "@oberoncms/core": "workspace:*",
    "@oberoncms/plugin-development": "workspace:*",
    "@oberoncms/plugin-nextjs": "workspace:*",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-cli-only": "^0.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
